<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="first_robot">
  <!-- <xacro:include filename="$(find mybot_description)/urdf/first_robot_base.xacro"/>
  <xacro:include filename="$(find mybot_description)/urdf/first_robot_arm.xacro"/>
  <xacro:include filename="$(find mybot_description)/urdf/first_robot_gripper.xacro"/> -->

    <xacro:macro name="base_link" params              =              "length radius">
            <!--机器人身体-->
        <link name="base_link">
            <visual>
                <!--沿自己几何中心偏移量-->
                <origin xyz="0 0 0.0" rpy="0 0 0"/>
                <!--几何形状-->
                <geometry>
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
                <!--材质和颜色-->
                <material name="white">
                    <color rgba="1 1 1 0.5"/>
                </material>
            </visual>
        </link>
    </xacro:macro>

    <xacro:macro name="imu_link" params = "imu_name joint_xyz link_xyz">
        <link name="${imu_name}_link">
            <visual>
                <origin xyz="${link_xyz}" rpy="0 0 0"/>
                <geometry>
                    <box size="0.02 0.02 0.02"/>
                </geometry>
                <material name="red">
                    <color rgba="1 0 0 1"/>
                </material>
            </visual>
        </link>

        <joint name="${imu_name}_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${imu_name}_link"/>
            <origin xyz="${joint_xyz}" rpy="0 0 0"/>
        </joint>
    </xacro:macro>

    <xacro:base_link length="0.12" radius="0.10"/>
    <xacro:imu_link imu_name="imu1" joint_xyz="0 0 0.02" link_xyz="0 0 0.01"/>
    <xacro:imu_link imu_name="imu2" joint_xyz="0 0 -0.02" link_xyz="0 0 -0.01"/>

</robot>