<?xml version="1.0"?>
<robot name="fishbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include base macro -->
  <xacro:include filename="$(find mybot_description)/urdf/fishbot/base.urdf.xacro"/>

  <!-- Include modular sensor components from sensor folder -->
  <xacro:include filename="$(find mybot_description)/urdf/fishbot/sensor/camera.urdf.xacro"/>
  <xacro:include filename="$(find mybot_description)/urdf/fishbot/sensor/imu.urdf.xacro"/>
  <xacro:include filename="$(find mybot_description)/urdf/fishbot/sensor/laser.urdf.xacro"/>
  <xacro:include filename="$(find mybot_description)/urdf/fishbot/actuator/wheel.xacro"/>
  <xacro:include filename="$(find mybot_description)/urdf/fishbot/actuator/caster.xacro"/>
  <xacro:include filename="$(find mybot_description)/urdf/fishbot/plugins/gazebo_control_plugins.xacro"/>
  <xacro:include filename="$(find mybot_description)/urdf/fishbot/plugins/gazebo_sensor_plugins.xacro"/>

   <!-- Instantiate Gazebo control plugins -->

  <!-- Instantiate base: cylinder length=0.12, radius=0.1 -->
  <xacro:base_xacro length="0.1" radius="0.12"/>

  <!-- Instantiate sensors with provided parameters -->
  <xacro:imu_xacro joint_xyz="0 0 0.02"/>
  <xacro:camera_xacro joint_xyz="0.1 0 0.05"/>
  <xacro:laser_xacro joint_xyz="0 0 0.1"/>

  <xacro:wheel_xacro wheel_name="left_wheel" xyz="0 0.1 -0.05"/>
  <xacro:wheel_xacro wheel_name="right_wheel" xyz="0 -0.1 -0.05"/>

  <xacro:caster_xacro caster_name="front_caster" xyz="0.08 0 -0.05"/>
  <xacro:caster_xacro caster_name="back_caster" xyz="-0.08 0 -0.05"/>
  <xacro:gazebo_control_plugins/>
  <xacro:gazebo_sensor_plugin/>





</robot>
